-- =============================================
-- 1. Création d'un groupe + rattachement du/des premier(s) document(s)
--    Garantit la règle "1,N" : impossible de créer un groupe vide
-- =============================================
CREATE OR ALTER PROCEDURE dbo.sp_DocumentGroup_Create
    @IdVhl      INT,
        @IdDocList  dbo.IntList READONLY,   -- type table (voir plus bas), liste des Document.Id à rattacher
            @Comment    VARCHAR(256) = NULL,
                @IdGroup    INT OUTPUT
                AS
                BEGIN
                    SET NOCOUNT ON;
                        SET XACT_ABORT ON;

                            IF NOT EXISTS (SELECT 1 FROM @IdDocList)
                                BEGIN
                                        RAISERROR('Un groupe doit contenir au moins un document.', 16, 1);
                                                RETURN;
                                                    END

                                                        -- Vérifie que tous les documents fournis ont bien le même Type et la même date
                                                            IF EXISTS (
                                                                        SELECT 1
                                                                                FROM dbo.Document d
                                                                                        INNER JOIN @IdDocList l ON l.Id = d.Id
                                                                                                GROUP BY 1
                                                                                                        HAVING COUNT(DISTINCT d.Type) > 1
                                                                                                                    OR COUNT(DISTINCT CAST(d.CreatedDate AS DATE)) > 1
                                                            )
                                                                BEGIN
                                                                        RAISERROR('Tous les documents d''un groupe doivent avoir le même Type et la même date d''upload.', 16, 1);
                                                                                RETURN;
                                                                                    END

                                                                                        -- Vérifie qu'aucun document fourni n'est déjà rattaché à un autre groupe
                                                                                            IF EXISTS (
                                                                                                        SELECT 1 FROM dbo.DocumentGroupItem dgi
                                                                                                                INNER JOIN @IdDocList l ON l.Id = dgi.IdDoc
                                                                                            )
                                                                                                BEGIN
                                                                                                        RAISERROR('Un ou plusieurs documents sont déjà rattachés à un groupe.', 16, 1);
                                                                                                                RETURN;
                                                                                                                    END

                                                                                                                        BEGIN TRANSACTION;

                                                                                                                            BEGIN TRY
                                                                                                                                    DECLARE @IdComment INT = NULL;

                                                                                                                                            IF @Comment IS NOT NULL
                                                                                                                                                    BEGIN
                                                                                                                                                                INSERT INTO dbo.CommentGroup (Comment) VALUES (@Comment);
                                                                                                                                                                            SET @IdComment = SCOPE_IDENTITY();
                                                                                                                                                                                    END

                                                                                                                                                                                            INSERT INTO dbo.DocumentGroup (IdVhl, IdComment)
                                                                                                                                                                                                    VALUES (@IdVhl, @IdComment);

                                                                                                                                                                                                            SET @IdGroup = SCOPE_IDENTITY();

                                                                                                                                                                                                                    INSERT INTO dbo.DocumentGroupItem (IdGroup, IdDoc)
                                                                                                                                                                                                                            SELECT @IdGroup, Id FROM @IdDocList;

                                                                                                                                                                                                                                    COMMIT TRANSACTION;
                                                                                                                                                                                                                                        END TRY
                                                                                                                                                                                                                                            BEGIN CATCH
                                                                                                                                                                                                                                                    IF XACT_STATE() <> 0 ROLLBACK TRANSACTION;
                                                                                                                                                                                                                                                            THROW;
                                                                                                                                                                                                                                                                END CATCH
                                                                                                                                                                                                                                                                END;
                                                                                                                                                                                                                                                                GO

                                                                                                                                                                                                                                                                -- =============================================
                                                                                                                                                                                                                                                                -- 2. Ajout d'un document à un groupe existant
                                                                                                                                                                                                                                                                --    Vérifie la cohérence Type/Date avec le groupe cible
                                                                                                                                                                                                                                                                -- =============================================
                                                                                                                                                                                                                                                                CREATE OR ALTER PROCEDURE dbo.sp_DocumentGroup_AddDocument
                                                                                                                                                                                                                                                                    @IdGroup INT,
                                                                                                                                                                                                                                                                        @IdDoc   INT
                                                                                                                                                                                                                                                                        AS
                                                                                                                                                                                                                                                                        BEGIN
                                                                                                                                                                                                                                                                            SET NOCOUNT ON;
                                                                                                                                                                                                                                                                                SET XACT_ABORT ON;

                                                                                                                                                                                                                                                                                    IF EXISTS (SELECT 1 FROM dbo.DocumentGroupItem WHERE IdDoc = @IdDoc)
                                                                                                                                                                                                                                                                                        BEGIN
                                                                                                                                                                                                                                                                                                RAISERROR('Ce document est déjà rattaché à un groupe.', 16, 1);
                                                                                                                                                                                                                                                                                                        RETURN;
                                                                                                                                                                                                                                                                                                            END

                                                                                                                                                                                                                                                                                                                -- Le nouveau document doit avoir le même Type/date que les documents déjà dans le groupe
                                                                                                                                                                                                                                                                                                                    IF EXISTS (
                                                                                                                                                                                                                                                                                                                                SELECT 1
                                                                                                                                                                                                                                                                                                                                        FROM dbo.DocumentGroupItem dgi
                                                                                                                                                                                                                                                                                                                                                INNER JOIN dbo.Document dExisting ON dExisting.Id = dgi.IdDoc
                                                                                                                                                                                                                                                                                                                                                        CROSS JOIN dbo.Document dNew
                                                                                                                                                                                                                                                                                                                                                                WHERE dgi.IdGroup = @IdGroup
                                                                                                                                                                                                                                                                                                                                                                          AND dNew.Id = @IdDoc
                                                                                                                                                                                                                                                                                                                                                                                    AND (dExisting.Type <> dNew.Type
                                                                                                                                                                                                                                                                                                                                                                                                   OR CAST(dExisting.CreatedDate AS DATE) <> CAST(dNew.CreatedDate AS DATE))
                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                        BEGIN
                                                                                                                                                                                                                                                                                                                                RAISERROR('Le document ne correspond pas au Type/date du groupe cible.', 16, 1);
                                                                                                                                                                                                                                                                                                                                        RETURN;
                                                                                                                                                                                                                                                                                                                                            END

                                                                                                                                                                                                                                                                                                                                                INSERT INTO dbo.DocumentGroupItem (IdGroup, IdDoc)
                                                                                                                                                                                                                                                                                                                                                    VALUES (@IdGroup, @IdDoc);
                                                                                                                                                                                                                                                                                                                                                    END;
                                                                                                                                                                                                                                                                                                                                                    GO

                                                                                                                                                                                                                                                                                                                                                    -- =============================================
                                                                                                                                                                                                                                                                                                                                                    -- 3. Modification du commentaire d'un groupe (créer / mettre à jour / supprimer)
                                                                                                                                                                                                                                                                                                                                                    -- =============================================
                                                                                                                                                                                                                                                                                                                                                    CREATE OR ALTER PROCEDURE dbo.sp_DocumentGroup_UpdateComment
                                                                                                                                                                                                                                                                                                                                                        @IdGroup INT,
                                                                                                                                                                                                                                                                                                                                                            @Comment VARCHAR(256) = NULL   -- NULL => suppression du commentaire
                                                                                                                                                                                                                                                                                                                                                            AS
                                                                                                                                                                                                                                                                                                                                                            BEGIN
                                                                                                                                                                                                                                                                                                                                                                SET NOCOUNT ON;
                                                                                                                                                                                                                                                                                                                                                                    SET XACT_ABORT ON;

                                                                                                                                                                                                                                                                                                                                                                        DECLARE @IdComment INT;
                                                                                                                                                                                                                                                                                                                                                                            SELECT @IdComment = IdComment FROM dbo.DocumentGroup WHERE Id = @IdGroup;

                                                                                                                                                                                                                                                                                                                                                                                BEGIN TRANSACTION;

                                                                                                                                                                                                                                                                                                                                                                                    BEGIN TRY
                                                                                                                                                                                                                                                                                                                                                                                            IF @Comment IS NULL
                                                                                                                                                                                                                                                                                                                                                                                                    BEGIN
                                                                                                                                                                                                                                                                                                                                                                                                                IF @IdComment IS NOT NULL
                                                                                                                                                                                                                                                                                                                                                                                                                            BEGIN
                                                                                                                                                                                                                                                                                                                                                                                                                                            UPDATE dbo.DocumentGroup SET IdComment = NULL WHERE Id = @IdGroup;
                                                                                                                                                                                                                                                                                                                                                                                                                                                            DELETE FROM dbo.CommentGroup WHERE Id = @IdComment;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        END
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                END
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ELSE IF @IdComment IS NULL
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                BEGIN
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            INSERT INTO dbo.CommentGroup (Comment) VALUES (@Comment);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        UPDATE dbo.DocumentGroup SET IdComment = SCOPE_IDENTITY() WHERE Id = @IdGroup;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                END
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ELSE
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                BEGIN
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            UPDATE dbo.CommentGroup SET Comment = @Comment WHERE Id = @IdComment;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    END

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            COMMIT TRANSACTION;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                END TRY
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    BEGIN CATCH
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            IF XACT_STATE() <> 0 ROLLBACK TRANSACTION;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    THROW;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        END CATCH
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        END;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        GO

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        -- =============================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        -- 4. Retrait d'un document d'un groupe
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        --    Si c'était le dernier document, supprime le groupe (respecte la règle 1,N)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        -- =============================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        CREATE OR ALTER PROCEDURE dbo.sp_DocumentGroup_RemoveDocument
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            @IdDoc INT
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            AS
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            BEGIN
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                SET NOCOUNT ON;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    SET XACT_ABORT ON;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        DECLARE @IdGroup INT, @IdComment INT, @RemainingCount INT;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            SELECT @IdGroup = IdGroup FROM dbo.DocumentGroupItem WHERE IdDoc = @IdDoc;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                IF @IdGroup IS NULL
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    BEGIN
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            RAISERROR('Ce document n''appartient à aucun groupe.', 16, 1);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    RETURN;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        END

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            BEGIN TRANSACTION;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                BEGIN TRY
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        DELETE FROM dbo.DocumentGroupItem WHERE IdDoc = @IdDoc;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                SELECT @RemainingCount = COUNT(*) FROM dbo.DocumentGroupItem WHERE IdGroup = @IdGroup;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        IF @RemainingCount = 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                BEGIN
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            SELECT @IdComment = IdComment FROM dbo.DocumentGroup WHERE Id = @IdGroup;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        DELETE FROM dbo.DocumentGroup WHERE Id = @IdGroup;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    IF @IdComment IS NOT NULL
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    DELETE FROM dbo.CommentGroup WHERE Id = @IdComment;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            END

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    COMMIT TRANSACTION;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        END TRY
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            BEGIN CATCH
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    IF XACT_STATE() <> 0 ROLLBACK TRANSACTION;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            THROW;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                END CATCH
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                END;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                GO
                                                                                                                                                                                                                                                                                                                    )
                                                                                            )
                                                            )